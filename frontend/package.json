{
  "name": "pdbook-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "pdfjs-assets": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "npm run pdfjs-assets && vite",
    "build": "npm run pdfjs-assets && tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node-tests.json",
    "test": "vitest run",
    "preview": "vite preview",
    "build:app": "npm run pdfjs-assets && node scripts/prepare-app-public.mjs && tsc --noEmit -p tsconfig.json && vite build --mode app",
    "dev:app": "npm run pdfjs-assets && node scripts/prepare-app-public.mjs && vite --mode app",
    "android:sync": "npm run build:app && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "lucide-react": "^1.62.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
