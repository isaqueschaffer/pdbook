# =====================================================================
# BookFlow — configuração. Copie para .env e preencha. NUNCA versione o .env.
# Os valores abaixo são fictícios.
# =====================================================================

# --- Ambiente e logs ---
# development | production | test
ENVIRONMENT=production
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Banco de dados (Neon PostgreSQL) ---
# Painel do Neon > Connect. Use a URL "pooled" (host com -pooler) para a aplicação
# e a URL direta (sem -pooler) para as migrations. Mantenha sslmode=require.
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-123456-pooler.sa-east-1.aws.neon.tech/bookflow?sslmode=require
DATABASE_MIGRATION_URL=postgresql://usuario:senha@ep-exemplo-123456.sa-east-1.aws.neon.tech/bookflow?sslmode=require
# conexões por processo da API (2 processos uvicorn => até 2*(3+2))
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# --- Sessões ---
# Segredo usado para assinar (HMAC) os tokens de sessão. Gere com: openssl rand -hex 32
# (JWT_SECRET é aceito como nome alternativo.)
SESSION_SECRET=troque-por-uma-sequencia-aleatoria-de-64-caracteres-hexadecimais
SESSION_TTL_DAYS=30
# true em produção (HTTPS). Use false apenas em testes via http://
COOKIE_SECURE=true

# --- Redis / fila (apenas rede interna do Docker) ---
REDIS_PASSWORD=troque-esta-senha-do-redis
REDIS_URL=redis://:troque-esta-senha-do-redis@redis:6379/0

# --- Worker de conversão ---
# processos do worker; o OCR roda sempre em um só
WORKER_CONCURRENCY=1
# tempo máximo de uma conversão de texto
JOB_TIMEOUT_SECONDS=900
# tempo máximo de uma conversão com OCR
OCR_JOB_TIMEOUT_SECONDS=3600
# novas tentativas para falhas temporárias
JOB_MAX_RETRIES=2
# limite de memória por conversão (0 = sem limite)
WORKER_MEMORY_LIMIT_MB=1536

# --- Armazenamento persistente (Block Volume da VM) ---
# diretório do host montado em /data nos containers
DATA_DIR=/mnt/bookflow-data
UPLOAD_DIR=/data/originals
CONVERTED_DIR=/data/converted
TMP_DIR=/data/tmp
# teto total para PDFs + conteúdo convertido
STORAGE_LIMIT_MB=40000
# alerta na interface a partir deste uso
STORAGE_WARN_PERCENT=85
# recusa envios se o disco ficar abaixo disso
MIN_FREE_DISK_MB=1024
# cota por usuário (0 = sem cota)
USER_QUOTA_MB=0

# --- Documentos ---
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=250
MAX_IMAGES_PER_BOOK=300

# --- OCR (Tesseract) ---
OCR_ENABLED=true
OCR_LANGUAGES=por+eng
OCR_DPI=200
OCR_PAGE_TIMEOUT=120
# abaixo disso a página é considerada digitalizada
OCR_MIN_CHARS_PER_PAGE=40

# --- HTTP / domínio ---
# domínio para HTTPS automático; use :80 para testar sem domínio
SITE_ADDRESS=leitura.exemplo.com
# e-mail para avisos do Let's Encrypt
ACME_EMAIL=voce@exemplo.com
FRONTEND_URL=https://leitura.exemplo.com
# origens extras, separadas por vírgula (normalmente vazio)
CORS_ORIGINS=
# limite no proxy; mantenha um pouco acima de MAX_UPLOAD_MB
MAX_REQUEST_BODY=52MB

# --- Limites de requisições (por janela, em segundos) ---
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=300
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW=3600
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW=3600

# --- Recursos dos containers ---
API_WORKERS=2
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=3g
WORKER_CPUS=1.5
# prefira rodar as migrations manualmente (veja docs/DEPLOY_OCI.md)
RUN_MIGRATIONS_ON_START=false

# --- Backup (scripts/backup.sh) ---
# ex.: gdrive:bookflow-backups  ou  oci-os:bookflow-backups
BACKUP_RCLONE_REMOTE=
# alternativa: usuario@outro-servidor:/backups/bookflow
BACKUP_RSYNC_TARGET=
BACKUP_KEEP_DAYS=30
# o conteúdo convertido pode ser regenerado reprocessando
BACKUP_INCLUDE_CONVERTED=false
